# Configuration template only. Never commit the populated values.
# Separate Vercel project: no link to the main AgentPay project or database.
AGENTPAY_EDITION=hackathon
AGENTPAY_HOSTING_PROFILE=isolated-hackathon
APP_ORIGIN=https://hackathon.agentpay.twoaye.com
PAYPAL_ENVIRONMENT=sandbox
AGENTPAY_PROTECTED_CAPTURE_ENABLED=false
AGENTPAY_SANDBOX_CHECKOUT_ENABLED=true
AGENTPAY_SESSION_API_URL=
# Dedicated database AND principal. Name agentpay_hackathon_*, sslmode=verify-full recommended.
DATABASE_URL=
# Dedicated sandbox business app and model credentials, not production credentials.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_MERCHANT_ID=
AGENTPAY_AI_PROVIDER=anthropic
AGENTPAY_AI_MODEL=anthropic/claude-haiku-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
# Optional canonical sandbox profile; absence blocks signed authorization/capture.
# Production API origins are refused even if this value is changed to match them.
AGENTPAY_HACKATHON_CANONICAL_ORIGIN=
AUTHORITY_BASE_URL=
AUTHORITY_LOCAL_TENANT_ID=
AUTHORITY_LOCAL_USER_ID=
AUTHORITY_PRINCIPAL_ID=
AUTHORITY_TENANT_ID=
AUTHORITY_AGENT_ID=
AUTHORITY_INTENT_ID=
AUTHORITY_INTENT_VERSION=
AUTHORITY_TOOL=paypal
AUTHORITY_ACTION=capture
AUTHORITY_ACCESS_TOKEN=
AGENTPAY_CANONICAL_REQUIRED=false
AGENTPAY_CANONICAL_LOGIN_ENABLED=false
