# Server only. Never prefix credentials with NEXT_PUBLIC_.
# Optional read-only production eBay Browse API token, operator renewed.
# Requires provider access. Missing token returns NOT_CONFIGURED, never demo offers.
AGENTPAY_EBAY_BROWSE_TOKEN=
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_MERCHANT_ID=
PAYPAL_SANDBOX_WEBHOOK_ID=
AGENTPAY_VERIFY_RECEIPT_ID=
AGENTPAY_PROBE_PURCHASE_ID=
AGENTPAY_SANDBOX_CHECKOUT_ENABLED=true
AGENTPAY_PROTECTED_CAPTURE_ENABLED=false
# Separate receiver key custody and pinned verification key, never issuer keys.
AGENTPAY_RECEIVER_SIGNING_KEY_FILE=
AGENTPAY_RECEIVER_PUBLIC_KEY_FILE=
AGENTPAY_RECEIVER_KEY_ID=
# Operator-managed local-to-platform tenant mapping. No client may set these.
AUTHORITY_LOCAL_TENANT_ID=
AUTHORITY_LOCAL_USER_ID=
AUTHORITY_PRINCIPAL_ID=
AUTHORITY_BASE_URL=
AUTHORITY_TENANT_ID=
AUTHORITY_AGENT_ID=
AUTHORITY_INTENT_ID=
AUTHORITY_INTENT_VERSION=
AUTHORITY_TOOL=
AUTHORITY_ACTION=
AUTHORITY_ACCESS_TOKEN=
# Authorization integration and persistent execution state remain required.

DATABASE_URL=postgresql://agentpay:change-me@127.0.0.1:5454/agentpay_hackathon_judges
APP_ORIGIN=http://localhost:3006
# Used only by the local provisioning command, never returned by the API.
AGENTPAY_USER_EMAIL=
AGENTPAY_USER_PASSWORD=

# Server-only model access. Catalog proposals never receive payment authority.
AGENTPAY_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Required for keys that are not scoped to one workspace.
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
AGENTPAY_AI_MODEL=anthropic/claude-haiku-5-5
# Rolling proposal limits across every replica sharing the AgentPay database.
# Values may only lower these ceilings. Failed attempts still count.
AGENTPAY_AI_USER_HOURLY_LIMIT=3
AGENTPAY_AI_GLOBAL_HOURLY_LIMIT=10
AGENTPAY_AI_GLOBAL_DAILY_LIMIT=25

# Optional authenticated account-link migration. Requires a registered platform
# PKCE client for the exact tenant/application. This does not enable SSO or capture.
AGENTPAY_IDENTITY_API_URL=
AGENTPAY_IDENTITY_TENANT_ID=
AGENTPAY_IDENTITY_APPLICATION_ID=
AGENTPAY_IDENTITY_CLIENT_ID=
# Stage 2 proprietary registered-client handoff (not OIDC conformance).
AGENTPAY_CANONICAL_LOGIN_ENABLED=false
AGENTPAY_CANONICAL_REQUIRED=false
AGENTPAY_UNIVERSAL_LOGIN_URL=
AGENTPAY_CONSOLE_URL=
# Required 32-byte hex encryption key, shared across replicas/restarts; no fallback.
AGENTPAY_IDENTITY_SESSION_KEY_HEX=

# Split frontend deployment only: trusted HTTPS session endpoint on the existing backend.
# Leave empty when pages and API run together with the existing database.
AGENTPAY_SESSION_API_URL=
