{
  "schemaVersion": 1,
  "name": "AgentPay PayPal AI Hackathon Edition",
  "entrypoints": {
    "overview": "README.md",
    "agentInstructions": "AGENTS.md",
    "architecture": "docs/architecture.md",
    "setup": "docs/judge-setup.md",
    "scenario": "docs/problem-demo.md",
    "security": "SECURITY.md",
    "developerGuide": "docs/developer-guide.md",
    "releasePolicy": "docs/release-policy.md",
    "verificationStatus": "docs/verification-status.md"
  },
  "runtime": {
    "node": "24.x",
    "database": "PostgreSQL 17",
    "application": "Next.js",
    "localOrigin": "http://localhost:3006"
  },
  "commands": {
    "install": "npm ci",
    "lint": "npm run lint",
    "typecheck": "npm run typecheck",
    "test": "npm test",
    "build": "npm run build",
    "publicAudit": "npm run check:public",
    "boundaryTests": "npm run test:boundary",
    "sdkTests": "npm run test:sdk"
  },
  "testRequirements": [
    "Migrated disposable PostgreSQL database in DATABASE_URL",
    "No live provider credentials needed for fixture regression"
  ],
  "supportedScope": [
    "catalog-backed AI proposal",
    "human exact-term review",
    "PayPal Sandbox order creation and verification",
    "changed-terms refusal",
    "actor-scoped transaction evidence"
  ],
  "notEstablished": [
    "completed payment",
    "physical-device approval",
    "hardware attestation",
    "production acceptance"
  ],
  "captureEnabled": false,
  "standalone": true,
  "verification": {
    "asOf": "2026-11-12",
    "localRegression": "passed",
    "hostedJourney": "blocked",
    "blocker": "Owned transaction detail returned HTTP 404 despite an existing purchase",
    "providerReadbackAfterBlocker": "not_run",
    "paymentExecutedInSanityCheck": false,
    "details": "docs/verification-status.md",
    "publicationGuard": {
      "sourceInputs": 406,
      "rejectionTestsPassed": 4,
      "date": "2026-11-12"
    }
  },
  "releaseBoundary": {
    "sourceDependencies": "repository-local-or-public-registry",
    "externalAuthority": "optional-server-side-api-client",
    "sharedProductSessions": false,
    "independentSourceDownload": true,
    "privateCheckoutRequired": false
  },
  "supportedScopeBoundary": "Implemented application scope; hosted transaction evidence is currently blocked"
}
