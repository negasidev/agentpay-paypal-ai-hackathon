{
  "name": "agentpay-paypal-ai-hackathon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --webpack -H 127.0.0.1 -p 3006",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "test": "node --test --test-isolation=none tests/integration/*.test.mjs",
    "lint": "eslint src scripts tests",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "user:provision": "node --env-file=.env.local scripts/provision-user.mjs",
    "verify:hackathon": "node --env-file=.env.local scripts/verify-hackathon.mjs --providers"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.79",
    "@ai-sdk/openai": "^4.0.92",
    "@verid/agent-sdk": "file:./vendor/agent-sdk",
    "ai": "^7.0.133",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "9.39.5",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/negasidev/agentpay-paypal-ai-hackathon.git"
  }
}
